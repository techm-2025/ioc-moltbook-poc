# ONE shared env file for the whole stack. Copy to .env (git-ignored) and fill in.
#
# LLM access: everything goes through an OpenAI-compatible LiteLLM proxy that YOU run on the host
# (e.g. on port 4000). Containers cannot reach it as "localhost" (that is the container itself), so
# every URL below uses host.docker.internal. Check it from the host first:
#   curl http://localhost:4000/v1/models -H "Authorization: Bearer <your key>"
# The key must be one the proxy accepts without a database lookup (e.g. its master key) when the
# proxy runs without a DB, otherwise calls fail with "400 No connected db".
# Rate limits: one negotiation makes many calls within seconds; free tiers (e.g. Gemini, 15 req/min)
# fail with HTTP 429. Use a paid key / higher-quota model.

# --- Hermes agents ---
# LiteLLM key the 4 agents send to the proxy (referenced by config.template.yaml)
CUSTOM_API_KEY=
# Written into each agent's config.yaml at boot (hermes/agents/common/config.template.yaml).
# If unset they fall back to LLM_BASE_URL / LITELLM_MODEL. Apply changes with scripts/apply_agents.sh.
AGENT_LLM_BASE_URL=http://host.docker.internal:4000/v1   # OpenAI-compatible base URL, with /v1
AGENT_LLM_MODEL=gemini-flash    # model name served by your proxy (no "openai/" prefix)
HERMES_DASHBOARD_USER=admin
# login for the agent dashboards (ports below)
HERMES_DASHBOARD_PASSWORD=
FINANCEGUARD_PORT=8641          # host ports for the agent dashboards
CAREERMAX_PORT=8645             # 8642 is often taken by a host-installed Hermes gateway
STUDENTLIFE_PORT=8643
RISKANALYST_PORT=8644

# --- Mycelium ---
MYCELIUM_IMAGE_TAG=1.1.3
MYCELIUM_DB_PASSWORD=change-me
MYCELIUM_DB_PORT=5433           # host port; 5432 is often taken by a local Postgres
MYCELIUM_BACKEND_PORT=8000
MYCELIUM_UI_PORT=3000
CFN_MGMT_PORT=9000
CFN_NODE_PORT=9002
ADMIN_USER_PASSWORD=change-me
# CFN workspace: leave EMPTY. The CFN creates a random "Default Workspace" id on every fresh database
# (first start, `down -v`), and mycelium/scripts/backend-start.sh looks it up when the backend starts.
# Set an id only to pin a different workspace; a stale id is replaced automatically. List them with:
#   curl -s localhost:9000/api/workspaces
WORKSPACE_ID=
CFN_NAME=mycelium-cfn
CFN_DB=cfn_mgmt
CFN_DEV_MODE=true               # value the stack was tested with
COORDINATION_TICK_TIMEOUT_SECONDS=30
NEGOTIATION_N_STEPS=20
HC_INTERVAL=60                  # seconds between stack-health re-checks once healthy (docker compose logs stack-health)
MYCELIUM_ROOM=moltbook-mycelium-demo   # room the bridge posts to AND the 4 agents listen to; create it once + sync-mas (README Step 1)
# Mycelium backend + CFN node LLM (the node uses it to set up and run negotiations).
# litellm format: the "openai/" prefix routes the call to the OpenAI-compatible proxy at LLM_BASE_URL.
LLM_MODEL=openai/gemini-flash   # openai/<model name served by your proxy>
# proxy key (usually the same as CUSTOM_API_KEY)
LLM_API_KEY=
LLM_BASE_URL=http://host.docker.internal:4000/v1

# --- Moltbook (created by scripts/register_moltbook_accounts.py) ---
MOLTBOOK_API_KEY=
MOLTBOOK_API_KEY_FINANCEGUARD=
MOLTBOOK_API_KEY_CAREERMAX=
MOLTBOOK_API_KEY_STUDENTLIFE=
MOLTBOOK_API_KEY_RISKANALYST=

# --- Bridge (docker compose run --rm bridge ...; profile "bridge") ---
# LiteLLM key 1: bridge orchestrator + summariser
LITELLM_API_KEY=
LITELLM_USER_ID1=
# LiteLLM key 2 (token audit); the agents' key is CUSTOM_API_KEY
LITELLM_API_KEY2=
LITELLM_USER_ID2=
# LiteLLM proxy base URL for the bridge/summariser/topic engine; /v1/chat/completions is added by the
# code (a full .../v1/chat/completions URL also works).
LITELLM_URL=http://host.docker.internal:4000
LITELLM_MODEL=gemini-flash      # model name served by your proxy (no "openai/" prefix here)
# SCENARIO_FACTS / MOLTBOOK_SUBMOLT are optional overrides
